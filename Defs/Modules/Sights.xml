      <li>PLA_QJYTwoZeroOneE</li>
      <li>PLA_QJZOneSevenOne</li>
      <li>PLA_QBUTen</li> 
      </requiredWeaponTags>
    </li>
  </modExtensions>
  </ThingDef>

