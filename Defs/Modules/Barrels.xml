<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 长枪管渲染 -->
  <ThingDef ParentName="CWF_Module">
    <defName>PLA_Module_BarrelA</defName>
    <label>extended barrel</label>
    <graphicData>
      <texPath>CustomizePLAWeapon/Module/Barrel/EightOne</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>1500</WorkToMake>
    </statBases>
    <costList>
      <Steel>10</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <researchPrerequisite>PLA_Research_TacticalModification</researchPrerequisite>
    </recipeMaker>
    <modExtensions>
      <li Class="CWF.TraitModuleExtension">
        <weaponTraitDef>PLA_Trait_BarrelA</weaponTraitDef>
        <part>Barrel</part>
        <requiredWeaponTags>
          <li>PLA_QBZOneNineOne</li>
          <li>PLA_QBUTwoZeroTwo</li>
          <li>PLA_QJYTwoZeroOneE</li>
        </requiredWeaponTags>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 短枪管渲染 -->
  <ThingDef ParentName="CWF_Module">
    <defName>PLA_Module_BarrelB</defName>
    <label>shortened barrel</label>
    <graphicData>
      <texPath>CustomizePLAWeapon/Module/Barrel/EightOne</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>1500</WorkToMake>
    </statBases>
    <costList>
      <Steel>10</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <researchPrerequisite>PLA_Research_TacticalModification</researchPrerequisite>
    </recipeMaker>
    <modExtensions>
      <li Class="CWF.TraitModuleExtension">
        <weaponTraitDef>PLA_Trait_BarrelB</weaponTraitDef>
        <part>Barrel</part>
        <requiredWeaponTags>
          <li>PLA_QBZOneNineOne</li>
          <li>PLA_QBATwoTwoOne</li>
          <li>PLA_QBSZeroNine</li>
        </requiredWeaponTags>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>