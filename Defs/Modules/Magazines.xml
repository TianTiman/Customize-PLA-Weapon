<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- PLA弹鼓 -->
  <ThingDef ParentName="CWF_Module">
    <defName>PLA_Module_Magazine</defName>
    <label>PLA Drum magazine</label>
    <graphicData>
      <texPath>CustomizePLAWeapon/Module/Magazine/EightOne</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>1500</WorkToMake>
    </statBases>
    <costList>
      <Steel>10</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <researchPrerequisite>PLA_Research_TacticalModification</researchPrerequisite>
    </recipeMaker>
    <modExtensions>
      <li Class="CWF.TraitModuleExtension">
        <weaponTraitDef>PLA_Trait_Magazine</weaponTraitDef>
        <part>Magazine</part>
        <requiredWeaponTags>
          <li>PLA_QBZOneNineOne</li>
          <li>PLA_QBATwoTwoOne</li>
          <li>PLA_QBSZeroNine</li>
          <li>PLA_TypeFiftySix</li>          
        </requiredWeaponTags>
      </li>
    </modExtensions>
  </ThingDef>

